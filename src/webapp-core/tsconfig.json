{
  "compilerOptions": {
    "noImplicitAny": false,
    "noEmitOnError": false,
    "allowJs": true,
    "sourceMap": true,
    "target": "ESNext",
    "module": "ESNext",
    "declaration": true,
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": false,
    "experimentalDecorators": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src"
  },
  "include": [ "src" ]
}