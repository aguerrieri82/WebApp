{
  "compilerOptions": {
    "module": "NodeNext",
    "outDir": "dist",
    "sourceMap": true,
    "noEmitOnError": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": false,
    "rootDir": "src",
    "types": [ "node" ]
  },
  "compileOnSave": true,
  "include": [ "src" ]
}