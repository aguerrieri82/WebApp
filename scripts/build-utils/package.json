{
  "name": "build-utils",
  "version": "0.0.1",
  "type": "module",
  "bin": "dist/index.js",
  "scripts": {
    "install:pnpm": "pnpm install --fix-lockfile",
    "build": "tsc",
    "dist:dev": "node dist/index --dist --env:dev",
    "dist:prod": "node dist/index --dist --env:prod",
    "dist:pub": "node dist/index --dist --env:prod --publish --new",
    "upgrade": "pnpm update --latest"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}